generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider          = "mysql"
  url               = env("DATABASE_URL")
  shadowDatabaseUrl = env("SHADOW_DATABASE_URL")
}

model User {
  id                Int                 @id @default(autoincrement())
  rank              String              @default("M")
  userId            String              @unique
  password          String
  name              String
  group             String
  phone             String
  birth             DateTime?
  gender            String?
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @default(now()) @updatedAt
  isDeleted         Boolean             @default(false)
  email             String?             @unique(map: "IDX_User_email") @db.VarChar(255)
  emailVerifiedAt   DateTime?
  applications      Application[]
  createdRooms      CarpoolRoom[]       @relation("DriverRooms")
  chats             Chat[]              @relation("UserChats")
  reportsReceived   ChatReport[]        @relation("UserReportsReceived")
  reportsMade       ChatReport[]        @relation("UserReportsMade")
  ExpoPushToken     ExpoPushToken[]
  tokens            FcmToken[]          @relation("UserTokens")
  LectureEnrollment LectureEnrollment[]
  prays             Pray[]
  joinedRooms       CarpoolMember[]
  consents          Consent[]
}

model Application {
  id                  Int                      @id @default(autoincrement())
  idn                 String
  surveyData          Json
  attended            Boolean                  @default(false)
  feePaid             Boolean                  @default(false)
  createdAt           DateTime                 @default(now())
  updatedAt           DateTime                 @default(now()) @updatedAt
  userId              String
  retreatId           Int
  checkedInAt         DateTime?
  checkedInBy         String?
  eventResult         Application_eventResult?
  eventParticipatedAt DateTime?
  retreat             Retreat                  @relation(fields: [retreatId], references: [id])
  user                User                     @relation(fields: [userId], references: [userId])

  @@unique([userId, retreatId])
  @@index([retreatId], map: "Application_retreatId_fkey")
}

model Retreat {
  id           Int           @id @default(autoincrement())
  title        String
  date         DateTime
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @default(now()) @updatedAt
  applications Application[]
  youtubes     Youtube[]
}

model Youtube {
  id        Int      @id @default(autoincrement())
  link      String   @db.VarChar(255)
  createdAt DateTime @default(now())
  retreatId Int
  title     String
  retreat   Retreat  @relation(fields: [retreatId], references: [id])

  @@index([retreatId], map: "Youtube_retreatId_fkey")
}

model Pray {
  id        Int      @id @default(autoincrement())
  content   String
  createdAt DateTime @default(now())
  userId    Int
  user      User     @relation(fields: [userId], references: [id])

  @@index([userId], map: "Pray_userId_fkey")
}

model CarpoolRoom {
  id                  Int             @id @default(autoincrement())
  driverId            Int
  carInfo             String?
  departureTime       DateTime        @default(now())
  origin              String
  originDetailed      String?
  destination         String
  destinationDetailed String?
  seatsTotal          Int
  seatsLeft           Int
  note                String
  originLat           Decimal?        @db.Decimal(10, 6)
  originLng           Decimal?        @db.Decimal(10, 6)
  destLat             Decimal?        @db.Decimal(10, 6)
  destLng             Decimal?        @db.Decimal(10, 6)
  isArrived           Boolean         @default(false)
  createdAt           DateTime        @default(now())
  updatedAt           DateTime        @default(now()) @updatedAt
  status              String          @default("before_departure") @db.VarChar(50)
  driver              User            @relation("DriverRooms", fields: [driverId], references: [id])
  chats               Chat[]
  reports             ChatReport[]
  members             CarpoolMember[]

  @@index([driverId], map: "CarpoolRoom_driverId_fkey")
}

model CarpoolMember {
  roomId   Int
  userId   Int
  joinedAt DateTime    @default(now())
  room     CarpoolRoom @relation(fields: [roomId], references: [id])
  user     User        @relation(fields: [userId], references: [id])

  @@id([roomId, userId])
  @@index([userId], map: "carpool_members_userId_fkey")
  @@map("carpool_members")
}

model Chat {
  id        Int         @id @default(autoincrement())
  senderId  Int
  roomId    Int
  message   String
  timestamp DateTime
  room      CarpoolRoom @relation(fields: [roomId], references: [id])
  sender    User        @relation("UserChats", fields: [senderId], references: [id])

  @@unique([senderId, roomId, message, timestamp])
  @@index([roomId])
  @@index([senderId])
}

model ChatReport {
  id             Int         @id @default(autoincrement())
  reporterId     Int
  reportedUserId Int
  roomId         Int
  reason         String
  createdAt      DateTime    @default(now())
  reported       User        @relation("UserReportsReceived", fields: [reportedUserId], references: [id])
  reporter       User        @relation("UserReportsMade", fields: [reporterId], references: [id])
  room           CarpoolRoom @relation(fields: [roomId], references: [id])

  @@index([reporterId])
  @@index([reportedUserId])
  @@index([roomId])
}

model FcmToken {
  id       Int    @id @default(autoincrement())
  userId   Int
  token    String @unique
  platform String @default("android")
  user     User   @relation("UserTokens", fields: [userId], references: [id])

  @@index([userId])
}

model Consent {
  userId      Int
  consentType String
  consentedAt DateTime @default(now())
  value       Boolean
  user        User     @relation(fields: [userId], references: [id])

  @@id([userId, consentType])
  @@index([userId])
  @@map("user_consents")
}

model ExpoPushToken {
  id         Int       @id @default(autoincrement())
  userId     Int
  token      String    @unique
  provider   String    @default("expo") @db.VarChar(255)
  lastUsedAt DateTime? @db.Timestamp(0)
  createdAt  DateTime  @default(now()) @db.DateTime(6)
  User       User      @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "FK_6303af29989eb6ba75ea39a3b22")

  @@index([userId])
}

model Lecture {
  id                Int                 @id @default(autoincrement())
  title             String              @db.VarChar(255)
  introduction      String              @db.VarChar(255)
  instructor        String              @db.VarChar(255)
  location          String              @db.VarChar(255)
  currentCount      Int                 @default(0)
  maxCapacity       Int
  startTime         DateTime
  codeNumber        String              @db.VarChar(10)
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @default(now())
  term_id           Int
  instructorBio     String              @default("CBA 대학청년부 선교사") @db.VarChar(255)
  Term              Term                @relation(fields: [term_id], references: [id], onUpdate: NoAction, map: "FK_7e7f5cb578820dbb04b4d6718b7")
  LectureEnrollment LectureEnrollment[]

  @@unique([term_id, codeNumber], map: "uq_lecture_term_code")
}

model LectureEnrollment {
  id         Int      @id @default(autoincrement())
  lectureId  Int
  userId     Int
  enrolledAt DateTime @default(now())
  Lecture    Lecture  @relation(fields: [lectureId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "FK_67c535f2fcb06a06f461fbeddfc")
  User       User     @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "FK_6f8d80eeea2e450ee14e7238fe3")

  @@unique([lectureId, userId], map: "lecture_enrollment_unique")
  @@index([userId], map: "FK_6f8d80eeea2e450ee14e7238fe3")
}

model Notice {
  id        Int      @id @default(autoincrement())
  author    String   @db.VarChar(50)
  title     String   @db.VarChar(50)
  body      String
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now())
}

model SystemConfig {
  id                   Int      @id @default(autoincrement())
  appName              String
  versionName          String   @db.VarChar(50)
  versionCode          Int
  privacyPolicyUrl     String?  @db.VarChar(500)
  privacyPolicyVersion Int      @default(1)
  currentTermId        Int?
  currentRetreatId     Int?
  updatedAt            DateTime @default(now())
}

model Term {
  id          Int       @id @default(autoincrement())
  startDate   DateTime  @db.DateTime(0)
  endDate     DateTime  @db.DateTime(0)
  name        String    @db.VarChar(255)
  description String    @default("") @db.VarChar(255)
  Lecture     Lecture[]
}

model Term_type {
  id   Int    @id @default(autoincrement())
  name String @db.VarChar(255)
}

model migrations {
  id        Int    @id @default(autoincrement())
  timestamp BigInt
  name      String @db.VarChar(255)
}

enum Application_eventResult {
  WIN
  LOSE
}
